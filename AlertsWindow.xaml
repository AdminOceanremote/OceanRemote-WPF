<UserControl x:Class="OceanMonitor2.AlertsWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#040814" Foreground="#F8FAFC"
             FontFamily="Segoe UI, Consolas">

    <UserControl.Resources>
        <!-- SCADA Hierarchy Brushes -->
        <SolidColorBrush x:Key="BgDark" Color="#040814"/>
        <SolidColorBrush x:Key="PanelBg" Color="#081020"/>
        <SolidColorBrush x:Key="CardBg" Color="#060C1B"/>
        <SolidColorBrush x:Key="BorderPurple" Color="#A78BFA"/>
        <SolidColorBrush x:Key="BorderMuted" Color="#162238"/>

        <!-- Atmospheric Glows -->
        <DropShadowEffect x:Key="SubtleHUDGlow" Color="#7C3AED" BlurRadius="14" ShadowDepth="0" Opacity="0.25"/>
        <DropShadowEffect x:Key="CardGlow" Color="#0284C7" BlurRadius="16" ShadowDepth="0" Opacity="0.2"/>

        <!-- Dark Grid Pattern Texture -->
        <DrawingBrush x:Key="GridPatternBrush" TileMode="Tile" Viewport="0,0,32,32" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Geometry="M 0,0 L 32,0 32,32 0,32 Z">
                        <GeometryDrawing.Brush>
                            <SolidColorBrush Color="#040814"/>
                        </GeometryDrawing.Brush>
                    </GeometryDrawing>
                    <GeometryDrawing Geometry="M 0,32 L 32,32 M 32,0 L 32,32">
                        <GeometryDrawing.Pen>
                            <Pen Brush="#0A1528" Thickness="1"/>
                        </GeometryDrawing.Pen>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <!-- Cyber Action Button -->
        <Style x:Key="CyberActionBtn" TargetType="Button">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#A78BFA" BlurRadius="10" ShadowDepth="0" Opacity="0.5"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Styled Dark DatePicker -->
        <Style TargetType="DatePicker">
            <Setter Property="Background" Value="#060C1B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#162238"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <!-- Styled Dark ComboBox -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#060C1B"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#162238"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource GridPatternBrush}">
        <Grid.RowDefinitions>
            <!-- TOP COMMAND DECK -->
            <RowDefinition Height="Auto"/>
            <!-- FILTER CONFIGURATION STRIP -->
            <RowDefinition Height="Auto"/>
            <!-- ALERTS EVENT STREAM -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= ROW 0: COMMAND DECK ================= -->
        <Border Grid.Row="0" Background="#081020" BorderBrush="#162238" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="6" Background="#060C1B" 
                            BorderBrush="#A78BFA" BorderThickness="1.5" Effect="{StaticResource SubtleHUDGlow}">
                        <TextBlock Text="⚠️" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" Text="SYSTEM ALERTS // INCIDENT LOG" 
                                   Foreground="#F8FAFC" FontSize="15" FontWeight="Bold" FontFamily="Consolas"/>
                        <TextBlock Text="REAL-TIME ANOMALY DETECTION &amp; TELEMETRIC EXCURSIONS" 
                                   Foreground="#64748B" FontSize="10" FontWeight="SemiBold" FontFamily="Consolas" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#162238" CornerRadius="4" Padding="10,4" Margin="0,0,14,0" VerticalAlignment="Center">
                        <TextBlock x:Name="CountLabel" Text="0 ALERTS" Foreground="#A78BFA"
                                   FontSize="11" FontWeight="Bold" FontFamily="Consolas"/>
                    </Border>

                    <Button x:Name="BtnRefresh" Content="POLL / REFRESH" Click="Refresh_Click"
                            Style="{StaticResource CyberActionBtn}"
                            Background="#060C1B" Foreground="#38BDF8"
                            BorderBrush="#0284C7" BorderThickness="1"
                            Padding="14,6" Margin="0,0,8,0"/>

                    <Button x:Name="BtnMarkAll" Content="ACKNOWLEDGE ALL" Click="MarkAll_Click"
                            Style="{StaticResource CyberActionBtn}"
                            Background="#060C1B" Foreground="#A78BFA"
                            BorderBrush="#7C3AED" BorderThickness="1"
                            Padding="14,6"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= ROW 1: FILTER CONTROL STRIP ================= -->
        <Border Grid.Row="1" Margin="20,14,20,0" Background="#060C1B"
                CornerRadius="8" BorderBrush="#162238" BorderThickness="1"
                Padding="16,12" Effect="{StaticResource CardGlow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,14,0">
                    <TextBlock x:Name="LblDevice" Text="TARGET NODE FILTER" FontSize="10" 
                               Foreground="#64748B" FontWeight="Bold" FontFamily="Consolas"/>
                    <ComboBox x:Name="DeviceFilter" Height="30" Margin="0,6,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,14,0">
                    <TextBlock x:Name="LblDate" Text="SAMPLE DATE FILTER (OPTIONAL)" FontSize="10" 
                               Foreground="#64748B" FontWeight="Bold" FontFamily="Consolas"/>
                    <DatePicker x:Name="DateFilter" Height="30" Margin="0,6,0,0"/>
                </StackPanel>

                <Button Grid.Column="2" x:Name="BtnApply" Content="APPLY FILTER"
                        Click="Refresh_Click"
                        Style="{StaticResource CyberActionBtn}"
                        Background="#081020" Foreground="#38BDF8"
                        BorderBrush="#0284C7" BorderThickness="1"
                        FontWeight="Bold" Padding="18,0" Height="30"
                        VerticalAlignment="Bottom"/>
            </Grid>
        </Border>

        <!-- ================= ROW 2: ALERTS EVENT STREAM ================= -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="20,14,20,20">
            <ItemsControl x:Name="AlertsList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#060C1B" CornerRadius="8"
                                BorderBrush="{Binding BorderColor}" BorderThickness="1"
                                Margin="0,0,0,10" Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- ICON BADGE -->
                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="6"
                                        Background="#1E1014" BorderBrush="#EF4444" BorderThickness="1"
                                        VerticalAlignment="Center" Margin="0,0,14,0">
                                    <TextBlock Text="⚡" FontSize="16" Foreground="#EF4444"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <!-- DETAILS -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Message}"
                                               FontSize="13" FontWeight="Bold" FontFamily="Consolas"
                                               Foreground="#F8FAFC" TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                        <Border Background="#162238" CornerRadius="3" Padding="6,2">
                                            <TextBlock Text="{Binding DeviceName}"
                                                       FontSize="10" Foreground="#A78BFA"
                                                       FontWeight="Bold" FontFamily="Consolas"/>
                                        </Border>
                                        <TextBlock Text=" // " FontSize="10" Foreground="#334155" VerticalAlignment="Center" Margin="6,0"/>
                                        <TextBlock Text="{Binding TempThreshold}"
                                                   FontSize="10" Foreground="#38BDF8" FontFamily="Consolas" VerticalAlignment="Center"/>
                                        <TextBlock Text=" // " FontSize="10" Foreground="#334155" VerticalAlignment="Center" Margin="6,0"/>
                                        <TextBlock Text="{Binding TimeText}"
                                                   FontSize="10" Foreground="#64748B" FontFamily="Consolas" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- ACTION BUTTON -->
                                <Button Grid.Column="2" Content="ACKNOWLEDGE"
                                        Click="MarkRead_Click"
                                        Style="{StaticResource CyberActionBtn}"
                                        Background="#06281E" Foreground="#10B981"
                                        BorderBrush="#10B981" BorderThickness="1"
                                        FontWeight="Bold" FontSize="10"
                                        Padding="14,6" Margin="10,0,0,0"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding ReadButtonVisibility}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>