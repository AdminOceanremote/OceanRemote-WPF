<Window x:Class="OceanMonitor2.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Icon="pic2.ico"
        Title="OceanRemote | SCADA Access Portal" Height="780" Width="470"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="#F8FAFC"
        FontFamily="Segoe UI, Consolas">

    <Window.Resources>
        <!-- SCADA Palette Brushes -->
        <SolidColorBrush x:Key="BgDark" Color="#040814"/>
        <SolidColorBrush x:Key="PanelBg" Color="#070E1E"/>
        <SolidColorBrush x:Key="CardBg" Color="#060C1B"/>
        <SolidColorBrush x:Key="BorderCyan" Color="#38BDF8"/>
        <SolidColorBrush x:Key="BorderMuted" Color="#162238"/>

        <!-- Atmospheric Glows -->
        <DropShadowEffect x:Key="WindowShadow" Color="#000000" BlurRadius="30" ShadowDepth="4" Opacity="0.6"/>
        <DropShadowEffect x:Key="HUDCyanGlow" Color="#0284C7" BlurRadius="20" ShadowDepth="0" Opacity="0.3"/>
        <DropShadowEffect x:Key="ButtonGlow" Color="#38BDF8" BlurRadius="12" ShadowDepth="0" Opacity="0.4"/>

        <!-- Dark Grid Pattern -->
        <DrawingBrush x:Key="GridPatternBrush" TileMode="Tile" Viewport="0,0,32,32" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Geometry="M 0,0 L 32,0 32,32 0,32 Z">
                        <GeometryDrawing.Brush>
                            <SolidColorBrush Color="#050A17"/>
                        </GeometryDrawing.Brush>
                    </GeometryDrawing>
                    <GeometryDrawing Geometry="M 0,32 L 32,32 M 32,0 L 32,32">
                        <GeometryDrawing.Pen>
                            <Pen Brush="#0A1528" Thickness="1"/>
                        </GeometryDrawing.Pen>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <!-- Cyber Sign-In Button Style -->
        <Style x:Key="CyberLoginButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                                <Setter Property="Effect" Value="{StaticResource ButtonGlow}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Window Control Button Style -->
        <Style x:Key="WindowCloseButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="6,2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#EF4444"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer Frame Window Wrapper -->
    <Border Margin="14" Background="{StaticResource GridPatternBrush}" CornerRadius="14"
            BorderBrush="#162238" BorderThickness="1.5" Effect="{StaticResource WindowShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <!-- TITLEBAR DRAG STRIP -->
                <RowDefinition Height="36"/>
                <!-- MAIN CONTENT AREA -->
                <RowDefinition Height="*"/>
                <!-- FOOTER TELEMETRY STATUS -->
                <RowDefinition Height="26"/>
            </Grid.RowDefinitions>

            <!-- ROW 0: TITLEBAR DRAG STRIP -->
            <Border Grid.Row="0" Background="#060C1B" CornerRadius="14,14,0,0" BorderBrush="#162238" BorderThickness="0,0,0,1"
                    MouseDown="TitleBar_MouseDown">
                <Grid Margin="14,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Fill="#38BDF8" Margin="0,0,8,0"/>
                        <TextBlock Text="OCEANREMOTE // SECURITY GATEWAY" Foreground="#38BDF8" FontSize="10" FontWeight="Bold" FontFamily="Consolas"/>
                    </StackPanel>

                    <Button HorizontalAlignment="Right" VerticalAlignment="Center" Content="✕" 
                            Style="{StaticResource WindowCloseButton}" Click="CloseButton_Click"/>
                </Grid>
            </Border>

            <!-- ROW 1: LOGIN CARD BODY -->
            <StackPanel Grid.Row="1" Margin="38,20,38,10" VerticalAlignment="Center">

                <!-- Exact Circular Avatar: Completely cuts off all square/white edges -->
                <Border Width="114" Height="114" CornerRadius="57"
                        Background="#060C1B" HorizontalAlignment="Center"
                        BorderBrush="#38BDF8" BorderThickness="2"
                        Effect="{StaticResource HUDCyanGlow}">
                    <Ellipse Width="106" Height="106" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="pic2.jpg" Stretch="UniformToFill"/>
                        </Ellipse.Fill>
                    </Ellipse>
                </Border>

                <!-- System Title & Access Prompt -->
                <TextBlock x:Name="WelcomeText" Text="OPERATOR AUTHENTICATION"
                           FontSize="15" FontWeight="Bold" FontFamily="Consolas"
                           Foreground="#F8FAFC" HorizontalAlignment="Center" Margin="0,18,0,4"/>

                <TextBlock x:Name="SubtitleText" Text="COLD CHAIN MONITORING SUBSYSTEM"
                           FontSize="10" FontFamily="Consolas" Foreground="#64748B"
                           HorizontalAlignment="Center" Margin="0,0,0,24"/>

                <!-- Security Mode Pill -->
                <Border Background="#02040A" BorderBrush="#162238" BorderThickness="1" CornerRadius="4" 
                        Padding="8,4" HorizontalAlignment="Center" Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="LINK:" Foreground="#475569" FontSize="9" FontFamily="Consolas"/>
                        <TextBlock Text=" TLS 1.3 SECURE" Foreground="#10B981" FontSize="9" FontWeight="Bold" FontFamily="Consolas"/>
                        <TextBlock Text=" // NODE AUTH" Foreground="#38BDF8" FontSize="9" FontWeight="Bold" FontFamily="Consolas"/>
                    </StackPanel>
                </Border>

                <!-- USERNAME FIELD -->
                <TextBlock x:Name="UserLabelText" Text="OPERATOR IDENTIFIER"
                           FontSize="9" FontWeight="Bold" FontFamily="Consolas"
                           Foreground="#94A3B8" Margin="2,0,0,6"/>
                <Border Background="#02040A" CornerRadius="6" BorderBrush="#162238" BorderThickness="1" Margin="0,0,0,16">
                    <TextBox x:Name="UsernameBox" Height="40" FontSize="13" FontFamily="Consolas"
                             Background="Transparent" Foreground="#F8FAFC"
                             CaretBrush="#38BDF8" BorderThickness="0"
                             Padding="12,0" VerticalContentAlignment="Center"/>
                </Border>

                <!-- PASSWORD FIELD -->
                <TextBlock x:Name="PassLabelText" Text="ACCESS CIPHER KEY"
                           FontSize="9" FontWeight="Bold" FontFamily="Consolas"
                           Foreground="#94A3B8" Margin="2,0,0,6"/>
                <Border Background="#02040A" CornerRadius="6" BorderBrush="#162238" BorderThickness="1" Margin="0,0,0,16">
                    <PasswordBox x:Name="PasswordBox" Height="40" FontSize="13" FontFamily="Consolas"
                                 Background="Transparent" Foreground="#F8FAFC"
                                 CaretBrush="#38BDF8" BorderThickness="0"
                                 Padding="12,0" VerticalContentAlignment="Center"/>
                </Border>

                <!-- SERVER URL FIELD -->
                <TextBlock x:Name="ServerLabelText" Text="SERVER TELEMETRY ENDPOINT"
                           FontSize="9" FontWeight="Bold" FontFamily="Consolas"
                           Foreground="#94A3B8" Margin="2,0,0,6"/>
                <Border Background="#02040A" CornerRadius="6" BorderBrush="#162238" BorderThickness="1" Margin="0,0,0,22">
                    <TextBox x:Name="ServerUrlBox" Height="40" FontSize="12" FontFamily="Consolas"
                             Background="Transparent" Foreground="#38BDF8"
                             CaretBrush="#38BDF8" BorderThickness="0"
                             Padding="12,0" VerticalContentAlignment="Center"/>
                </Border>

                <!-- SUBMIT BUTTON -->
                <Button x:Name="LoginButton" Content="ESTABLISH LINK" Height="44"
                        Style="{StaticResource CyberLoginButton}"
                        Background="#082F49" Foreground="#38BDF8"
                        BorderBrush="#0284C7" BorderThickness="1.5"
                        Click="LoginButton_Click"/>

                <!-- ERROR / NOTICE TEXT -->
                <TextBlock x:Name="ErrorText" Foreground="#EF4444"
                           FontSize="11" FontFamily="Consolas" TextWrapping="Wrap"
                           Margin="0,12,0,0"
                           HorizontalAlignment="Center" TextAlignment="Center"/>
            </StackPanel>

            <!-- ROW 2: BOTTOM SCADA STATUS STRIP -->
            <Border Grid.Row="2" Background="#02040A" CornerRadius="0,0,14,14" BorderBrush="#162238" BorderThickness="0,1,0,0" Padding="14,0">
                <Grid VerticalAlignment="Center">
                    <TextBlock Text="STANDBY // ESP8266 REST CLOUD" Foreground="#475569" FontSize="8" FontFamily="Consolas"/>
                    <TextBlock Text="OCEANREMOTE SYS V2.6" Foreground="#38BDF8" FontSize="8" FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Right"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>