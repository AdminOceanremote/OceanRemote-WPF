<UserControl x:Class="OceanMonitor2.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#040814" Foreground="#F8FAFC"
             FontFamily="Segoe UI, Consolas">

    <UserControl.Resources>
        <!-- SCADA Palette Brushes -->
        <SolidColorBrush x:Key="BgDark" Color="#040814"/>
        <SolidColorBrush x:Key="PanelBg" Color="#081020"/>
        <SolidColorBrush x:Key="CardBg" Color="#060C1B"/>
        <SolidColorBrush x:Key="BorderCyan" Color="#38BDF8"/>
        <SolidColorBrush x:Key="BorderPurple" Color="#A78BFA"/>
        <SolidColorBrush x:Key="BorderMuted" Color="#162238"/>

        <!-- Atmospheric Glows -->
        <DropShadowEffect x:Key="SubtleHUDGlow" Color="#0284C7" BlurRadius="14" ShadowDepth="0" Opacity="0.25"/>
        <DropShadowEffect x:Key="CardGlow" Color="#0284C7" BlurRadius="16" ShadowDepth="0" Opacity="0.15"/>

        <!-- Dark Grid Pattern Texture -->
        <DrawingBrush x:Key="GridPatternBrush" TileMode="Tile" Viewport="0,0,32,32" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Geometry="M 0,0 L 32,0 32,32 0,32 Z">
                        <GeometryDrawing.Brush>
                            <SolidColorBrush Color="#040814"/>
                        </GeometryDrawing.Brush>
                    </GeometryDrawing>
                    <GeometryDrawing Geometry="M 0,32 L 32,32 M 32,0 L 32,32">
                        <GeometryDrawing.Pen>
                            <Pen Brush="#0A1528" Thickness="1"/>
                        </GeometryDrawing.Pen>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </UserControl.Resources>

    <Grid Background="{StaticResource GridPatternBrush}">
        <Grid.RowDefinitions>
            <!-- TOP COMMAND DECK -->
            <RowDefinition Height="Auto"/>
            <!-- MANUAL DOCUMENTATION CONTENT -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= ROW 0: COMMAND DECK ================= -->
        <Border Grid.Row="0" Background="#081020" BorderBrush="#162238" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="6" Background="#060C1B" 
                            BorderBrush="#A78BFA" BorderThickness="1.5" Effect="{StaticResource SubtleHUDGlow}">
                        <TextBlock Text="📖" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" Text="ABOUT // SYSTEM ARCHITECTURE &amp; MANUAL" 
                                   Foreground="#F8FAFC" FontSize="15" FontWeight="Bold" FontFamily="Consolas"/>
                        <TextBlock Text="OCEANREMOTE MONITOR COLD-CHAIN TELEMETRY SUBSYSTEM MANUAL" 
                                   Foreground="#64748B" FontSize="10" FontWeight="SemiBold" FontFamily="Consolas" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= ROW 1: DOCUMENTATION STREAM ================= -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="25">
            <StackPanel MaxWidth="900" HorizontalAlignment="Left">

                <!-- HEADER HERO -->
                <Border Background="#060C1B" CornerRadius="8" Padding="24"
                        BorderBrush="#162238" BorderThickness="1" Margin="0,0,0,20" Effect="{StaticResource CardGlow}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="OCEANREMOTE MONITOR" FontSize="26" FontWeight="Bold"
                                       Foreground="#38BDF8" FontFamily="Consolas"/>
                            <Border Background="#162238" CornerRadius="4" Padding="8,2" Margin="14,4,0,0" VerticalAlignment="Center">
                                <TextBlock Text="v1.0.0 SCADA STABLE" FontSize="10" FontWeight="Bold"
                                           Foreground="#10B981" FontFamily="Consolas"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Engineered for OceanRemote II Refrigeration &amp; OceanRemote IoT Infrastructure"
                                   FontSize="11" Foreground="#94A3B8" FontFamily="Consolas" Margin="0,6,0,16"/>

                        <TextBlock TextWrapping="Wrap" Foreground="#CBD5E1" FontSize="12" LineHeight="20" FontFamily="Consolas">
                            <Run>OceanRemote Monitor is a real-time SCADA monitoring console for the</Run>
                            <Run FontWeight="Bold" Foreground="#A78BFA"> OceanRemote II </Run>
                            <Run>refrigeration facilities. It ingests encrypted live telemetry streams from the cloud platform and provides high-resolution visualization for cold-chain compliance and early excursion warning.</Run>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- 1. GETTING STARTED -->
                <TextBlock Text="01 // OPERATOR INITIALIZATION" FontSize="13" FontWeight="Bold"
                           Foreground="#38BDF8" FontFamily="Consolas" Margin="0,0,0,8"/>
                <Border Background="#060C1B" CornerRadius="8" Padding="20"
                        BorderBrush="#162238" BorderThickness="1" Margin="0,0,0,20" Effect="{StaticResource CardGlow}">
                    <StackPanel>
                        <TextBlock Text="1.1  Authentication Portal" FontSize="13" FontWeight="Bold"
                                   Foreground="#FBBF24" FontFamily="Consolas" Margin="0,0,0,6"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#CBD5E1" FontSize="12" LineHeight="20" FontFamily="Consolas" Margin="0,0,0,14">
                            <Run>On first launch, enter your operator credentials. Press</Run>
                            <Run FontWeight="Bold" Foreground="#10B981"> [ENTER] </Run>
                            <Run>to instantly authenticate. Invalid credentials trigger localized cipher failure feedback.</Run>
                        </TextBlock>

                        <TextBlock Text="1.2  Encrypted Session Retention (DPAPI)" FontSize="13" FontWeight="Bold"
                                   Foreground="#FBBF24" FontFamily="Consolas" Margin="0,0,0,6"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#CBD5E1" FontSize="12" LineHeight="20" FontFamily="Consolas" Margin="0,0,0,14">
                            <Run>Session credentials are encrypted using</Run>
                            <Run FontWeight="Bold" Foreground="#38BDF8"> Windows Data Protection API (DPAPI)</Run>
                            <Run>. Only your local Windows user security context can decrypt the token for seamless auto-login.</Run>
                        </TextBlock>

                        <TextBlock Text="1.3  Navigation Architecture" FontSize="13" FontWeight="Bold"
                                   Foreground="#FBBF24" FontFamily="Consolas" Margin="0,0,0,6"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#CBD5E1" FontSize="12" LineHeight="20" FontFamily="Consolas">
                            <Run>The sidebar provides zero-latency routing between the</Run>
                            <Run FontWeight="Bold" Foreground="#38BDF8"> Dashboard</Run>
                            <Run>, </Run>
                            <Run FontWeight="Bold" Foreground="#EF4444"> Alerts</Run>
                            <Run>, </Run>
                            <Run FontWeight="Bold" Foreground="#A78BFA"> Settings</Run>
                            <Run>, and </Run>
                            <Run FontWeight="Bold" Foreground="#FBBF24"> System Manual</Run>
                            <Run>.</Run>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- 2. DASHBOARD -->
                <TextBlock Text="02 // TELEMETRIC DASHBOARD &amp; NODE MATRIX" FontSize="13" FontWeight="Bold"
                           Foreground="#38BDF8" FontFamily="Consolas" Margin="0,0,0,8"/>
                <Border Background="#060C1B" CornerRadius="8" Padding="20"
                        BorderBrush="#162238" BorderThickness="1" Margin="0,0,0,20" Effect="{StaticResource CardGlow}">
                    <StackPanel>
                        <TextBlock Text="2.1  Cold Room Matrix Nodes" FontSize="13" FontWeight="Bold"
                                   Foreground="#FBBF24" FontFamily="Consolas" Margin="0,0,0,6"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#CBD5E1" FontSize="12" LineHeight="20" FontFamily="Consolas" Margin="0,0,0,14">
                            <Run>Each assigned cold room node features an animated Chromium SVG radial gauge with dynamic threshold zones:</Run>
                            <LineBreak/>
                            <Run Foreground="#38BDF8">- Négative 1:</Run><Run> Target range [-25.0°C to -18.0°C]</Run>
                            <LineBreak/>
                            <Run Foreground="#38BDF8">- Négative 2:</Run><Run> Target range [-22.0°C to -15.0°C]</Run>
                            <LineBreak/>
                            <Run Foreground="#38BDF8">- Positive:</Run><Run> Target range [0.0°C to 4.0°C]</Run>
                            <LineBreak/>
                            <Run Foreground="#38BDF8">- Ingrédients:</Run><Run> Target range [4.0°C to 8.0°C]</Run>
                        </TextBlock>

                        <TextBlock Text="2.2  SCADA Rolling Trend &amp; Console" FontSize="13" FontWeight="Bold"
                                   Foreground="#FBBF24" FontFamily="Consolas" Margin="0,0,0,6"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#CBD5E1" FontSize="12" LineHeight="20" FontFamily="Consolas">
                            <Run>Cards feature real-time 3-hour micro sparklines alongside rolling Min, Mean, Max, and Drift telemetry with automated status logs.</Run>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- 3. AUDIT & REPORTING -->
                <TextBlock Text="03 // ANALYTICAL SUITE &amp; AUDITING" FontSize="13" FontWeight="Bold"
                           Foreground="#38BDF8" FontFamily="Consolas" Margin="0,0,0,8"/>
                <Border Background="#060C1B" CornerRadius="8" Padding="20"
                        BorderBrush="#162238" BorderThickness="1" Margin="0,0,0,20" Effect="{StaticResource CardGlow}">
                    <StackPanel>
                        <TextBlock Text="3.1  Diurnal &amp; Multi-Day Trends" FontSize="13" FontWeight="Bold"
                                   Foreground="#FBBF24" FontFamily="Consolas" Margin="0,0,0,6"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#CBD5E1" FontSize="12" LineHeight="20" FontFamily="Consolas" Margin="0,0,0,14">
                            <Run>Access single-day high resolution graphs via </Run>
                            <Run FontWeight="Bold" Foreground="#38BDF8">[TODAY]</Run>
                            <Run> or rolling multi-day average progressions via </Run>
                            <Run FontWeight="Bold" Foreground="#FBBF24">[MONTH]</Run>
                            <Run>.</Run>
                        </TextBlock>

                        <TextBlock Text="3.2  Fast Telemetry Audit (Report)" FontSize="13" FontWeight="Bold"
                                   Foreground="#FBBF24" FontFamily="Consolas" Margin="0,0,0,6"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#CBD5E1" FontSize="12" LineHeight="20" FontFamily="Consolas">
                            <Run>Generate multi-day printable audits with individual daily charts, excursion spreads, and stability badges (</Run>
                            <Run Foreground="#10B981" FontWeight="Bold">NOMINAL STABLE</Run>
                            <Run>, </Run>
                            <Run Foreground="#FBBF24" FontWeight="Bold">HIGH VARIANCE</Run>
                            <Run>, </Run>
                            <Run Foreground="#EF4444" FontWeight="Bold">CRITICAL BREACH</Run>
                            <Run>).</Run>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- 4. ALERTS & SETTINGS -->
                <TextBlock Text="04 // INCIDENT DISPATCH &amp; RECONFIGURATION" FontSize="13" FontWeight="Bold"
                           Foreground="#38BDF8" FontFamily="Consolas" Margin="0,0,0,8"/>
                <Border Background="#060C1B" CornerRadius="8" Padding="20"
                        BorderBrush="#162238" BorderThickness="1" Margin="0,0,0,20" Effect="{StaticResource CardGlow}">
                    <StackPanel>
                        <TextBlock Text="4.1  Alerts Management" FontSize="13" FontWeight="Bold"
                                   Foreground="#FBBF24" FontFamily="Consolas" Margin="0,0,0,6"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#CBD5E1" FontSize="12" LineHeight="20" FontFamily="Consolas" Margin="0,0,0,14">
                            <Run>Every excursion outside set thermal thresholds logs a critical incident. Operators can filter by node or sample date and acknowledge events individually or en masse.</Run>
                        </TextBlock>

                        <TextBlock Text="4.2  Configurable Telemetry Gateway" FontSize="13" FontWeight="Bold"
                                   Foreground="#FBBF24" FontFamily="Consolas" Margin="0,0,0,6"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#CBD5E1" FontSize="12" LineHeight="20" FontFamily="Consolas">
                            <Run>The client is server-agnostic. Customize the backend endpoint in </Run>
                            <Run FontWeight="Bold" Foreground="#A78BFA">[SETTINGS]</Run>
                            <Run> to connect to private clouds, on-premise Django gateways, or development endpoints.</Run>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- FOOTER -->
                <TextBlock Text="OCEANREMOTE MONITOR // SCADA TELEMETRY CLIENT // ALL RIGHTS RESERVED"
                           FontSize="10" Foreground="#64748B" FontFamily="Consolas"
                           HorizontalAlignment="Center" Margin="0,15,0,25"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>