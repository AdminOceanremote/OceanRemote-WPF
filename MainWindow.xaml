<Window x:Class="OceanMonitor2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Icon="pic2.ico"
        Title="OceanRemote Monitor" Height="780" Width="1320"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A" Foreground="White">

    <Window.Resources>
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="20,14"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="#38BDF8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#0B1220"
                BorderBrush="#1E293B" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="80"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="15,0">
                    <Border Width="42" Height="42" CornerRadius="10" Background="White">
                        <Image Source="pic2.jpg" Margin="4"/>
                    </Border>
                    <TextBlock Text="OCEANREMOTE" Foreground="#38BDF8"
                               FontSize="16" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,10,0,0">
                    <Button x:Name="NavDashboard" Content="DASHBOARD"
                            Click="NavDashboard_Click"
                            Style="{StaticResource NavButtonStyle}"/>
                    <Button x:Name="NavAlerts" Content="ALERTS"
                            Click="NavAlerts_Click"
                            Style="{StaticResource NavButtonStyle}"/>
                                        <Button x:Name="NavFirmware" Content="FIRMWARE"
                            Click="NavFirmware_Click"
                            Style="{StaticResource NavButtonStyle}"/>                                        <Button x:Name="NavDevices" Content="DEVICES"
                            Click="NavDevices_Click"
                            Style="{StaticResource NavButtonStyle}"/>                    <Button x:Name="NavSettings" Content="SETTINGS"
                            Click="NavSettings_Click"
                            Style="{StaticResource NavButtonStyle}"/>
                    <Button x:Name="NavAbout" Content="ABOUT"
                            Click="NavAbout_Click"
                            Style="{StaticResource NavButtonStyle}"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="15,15,15,20">
                    <TextBlock x:Name="UserLabel" Foreground="#94A3B8"
                               FontSize="11" Margin="0,0,0,8"/>
                    <Button Content="LOGOUT" Click="Logout_Click"
                            Background="#EF4444" Foreground="White"
                            FontWeight="Bold" Padding="10,8"
                            BorderThickness="0" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <ContentControl Grid.Column="1" x:Name="PageHost"/>
    </Grid>
</Window>