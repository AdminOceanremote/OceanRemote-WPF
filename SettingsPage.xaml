<UserControl x:Class="OceanMonitor2.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#040814" Foreground="#F8FAFC"
             FontFamily="Segoe UI, Consolas">

    <UserControl.Resources>
        <!-- SCADA Palette Brushes -->
        <SolidColorBrush x:Key="BgDark" Color="#040814"/>
        <SolidColorBrush x:Key="PanelBg" Color="#081020"/>
        <SolidColorBrush x:Key="CardBg" Color="#060C1B"/>
        <SolidColorBrush x:Key="BorderCyan" Color="#38BDF8"/>
        <SolidColorBrush x:Key="BorderPurple" Color="#A78BFA"/>
        <SolidColorBrush x:Key="BorderMuted" Color="#162238"/>

        <!-- Atmospheric Glows -->
        <DropShadowEffect x:Key="SubtleHUDGlow" Color="#0284C7" BlurRadius="14" ShadowDepth="0" Opacity="0.25"/>
        <DropShadowEffect x:Key="CardGlow" Color="#0284C7" BlurRadius="16" ShadowDepth="0" Opacity="0.2"/>

        <!-- Dark Grid Pattern Texture -->
        <DrawingBrush x:Key="GridPatternBrush" TileMode="Tile" Viewport="0,0,32,32" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Geometry="M 0,0 L 32,0 32,32 0,32 Z">
                        <GeometryDrawing.Brush>
                            <SolidColorBrush Color="#040814"/>
                        </GeometryDrawing.Brush>
                    </GeometryDrawing>
                    <GeometryDrawing Geometry="M 0,32 L 32,32 M 32,0 L 32,32">
                        <GeometryDrawing.Pen>
                            <Pen Brush="#0A1528" Thickness="1"/>
                        </GeometryDrawing.Pen>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <!-- Cyber Action Button -->
        <Style x:Key="CyberActionBtn" TargetType="Button">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#38BDF8" BlurRadius="10" ShadowDepth="0" Opacity="0.5"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource GridPatternBrush}">
        <Grid.RowDefinitions>
            <!-- TOP COMMAND DECK -->
            <RowDefinition Height="Auto"/>
            <!-- SETTINGS CONTENT -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= ROW 0: COMMAND DECK ================= -->
        <Border Grid.Row="0" Background="#081020" BorderBrush="#162238" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="6" Background="#060C1B" 
                            BorderBrush="#A78BFA" BorderThickness="1.5" Effect="{StaticResource SubtleHUDGlow}">
                        <TextBlock Text="⚙️" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" Text="SETTINGS // SYSTEM CONFIGURATION" 
                                   Foreground="#F8FAFC" FontSize="15" FontWeight="Bold" FontFamily="Consolas"/>
                        <TextBlock Text="OPERATOR PREFERENCES &amp; TELEMETRY INTERFACE ENDPOINTS" 
                                   Foreground="#64748B" FontSize="10" FontWeight="SemiBold" FontFamily="Consolas" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= ROW 1: SETTINGS CARDS ================= -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="25">
            <StackPanel MaxWidth="850" HorizontalAlignment="Left">

                <!-- 1. SERVER ENDPOINT -->
                <TextBlock x:Name="LblServer" Text="SERVER TELEMETRY ENDPOINT" FontSize="11" FontWeight="Bold"
                           FontFamily="Consolas" Foreground="#38BDF8" Margin="0,0,0,8"/>
                <Border Background="#060C1B" CornerRadius="8" Padding="20,16"
                        BorderBrush="#162238" BorderThickness="1" Margin="0,0,0,22" Effect="{StaticResource CardGlow}">
                    <StackPanel>
                        <TextBlock Text="Specify the cloud or local edge gateway URL for IoT cold chain telemetry data."
                                   Foreground="#94A3B8" FontSize="11" FontFamily="Consolas" Margin="0,0,0,10"/>
                        <TextBox x:Name="ServerUrlBox"
                                 Background="#040814" Foreground="#38BDF8" BorderBrush="#162238"
                                 FontFamily="Consolas" FontWeight="SemiBold"
                                 Padding="12,10" FontSize="13" Margin="0,0,0,12"/>
                        <Button x:Name="BtnSaveServer" Content="SAVE ENDPOINT"
                                Click="SaveServer_Click"
                                Style="{StaticResource CyberActionBtn}"
                                Background="#081020" Foreground="#38BDF8"
                                BorderBrush="#0284C7" BorderThickness="1"
                                Padding="18,8" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="ServerStatus" Foreground="#94A3B8"
                                   FontSize="11" FontFamily="Consolas" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 2. LANGUAGE SELECTION -->
                <TextBlock x:Name="LblLanguage" Text="OPERATOR LOCALE / LANGUAGE" FontSize="11" FontWeight="Bold"
                           FontFamily="Consolas" Foreground="#A78BFA" Margin="0,0,0,8"/>
                <Border Background="#060C1B" CornerRadius="8" Padding="20,16"
                        BorderBrush="#162238" BorderThickness="1" Margin="0,0,0,22" Effect="{StaticResource CardGlow}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="LangEnglish" Content="English (EN)"
                                     Foreground="#F8FAFC" FontFamily="Consolas" FontWeight="Bold"
                                     Margin="0,0,40,0"
                                     Checked="Lang_Changed"/>
                        <RadioButton x:Name="LangFrench" Content="Français (FR)"
                                     Foreground="#F8FAFC" FontFamily="Consolas" FontWeight="Bold"
                                     Checked="Lang_Changed"/>
                    </StackPanel>
                </Border>

                <!-- 3. THEME SELECTION -->
                <TextBlock x:Name="LblTheme" Text="DISPLAY THEME" FontSize="11" FontWeight="Bold"
                           FontFamily="Consolas" Foreground="#10B981" Margin="0,0,0,8"/>
                <Border Background="#060C1B" CornerRadius="8" Padding="20,16"
                        BorderBrush="#162238" BorderThickness="1" Margin="0,0,0,22" Effect="{StaticResource CardGlow}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="ThemeDark" Content="SCADA Dark HUD"
                                     Foreground="#F8FAFC" FontFamily="Consolas" FontWeight="Bold"
                                     Margin="0,0,40,0"
                                     Checked="Theme_Changed"/>
                        <RadioButton x:Name="ThemeLight" Content="Standard Light"
                                     Foreground="#F8FAFC" FontFamily="Consolas" FontWeight="Bold"
                                     Checked="Theme_Changed"/>
                    </StackPanel>
                </Border>

                <!-- 4. SYSTEM UPDATE -->
                <TextBlock x:Name="LblUpdate" Text="FIRMWARE &amp; SOFTWARE REVISION" FontSize="11" FontWeight="Bold"
                           FontFamily="Consolas" Foreground="#FBBF24" Margin="0,0,0,8"/>
                <Border Background="#060C1B" CornerRadius="8" Padding="20,16"
                        BorderBrush="#162238" BorderThickness="1" Margin="0,0,0,22" Effect="{StaticResource CardGlow}">
                    <StackPanel>
                        <TextBlock Text="Audit client build status against release repository."
                                   Foreground="#94A3B8" FontSize="11" FontFamily="Consolas" Margin="0,0,0,10"/>
                        <Button x:Name="BtnCheckUpdates" Content="QUERY RELEASE MANIFEST"
                                Click="CheckUpdates_Click"
                                Style="{StaticResource CyberActionBtn}"
                                Background="#081020" Foreground="#FBBF24"
                                BorderBrush="#D97706" BorderThickness="1"
                                Padding="18,8" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="UpdateStatus" Foreground="#94A3B8"
                                   FontSize="11" FontFamily="Consolas" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>