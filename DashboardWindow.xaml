<UserControl x:Class="OceanMonitor2.DashboardWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             Background="#040814" Foreground="#F8FAFC"
             FontFamily="Segoe UI, Consolas">

    <UserControl.Resources>
        <!-- SCADA Color Hierarchy -->
        <SolidColorBrush x:Key="BgDark" Color="#040814"/>
        <SolidColorBrush x:Key="PanelBg" Color="#070E1E"/>
        <SolidColorBrush x:Key="CardBg" Color="#060C1B"/>
        <SolidColorBrush x:Key="BorderCyan" Color="#38BDF8"/>
        <SolidColorBrush x:Key="BorderMuted" Color="#162238"/>

        <!-- Atmospheric Glows -->
        <DropShadowEffect x:Key="SubtleHUDGlow" Color="#0284C7" BlurRadius="14" ShadowDepth="0" Opacity="0.25"/>
        <DropShadowEffect x:Key="MatrixGlow" Color="#0284C7" BlurRadius="20" ShadowDepth="0" Opacity="0.25"/>

        <!-- Dark Matrix Grid Texture -->
        <DrawingBrush x:Key="GridPatternBrush" TileMode="Tile" Viewport="0,0,32,32" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Geometry="M 0,0 L 32,0 32,32 0,32 Z">
                        <GeometryDrawing.Brush>
                            <SolidColorBrush Color="#040814"/>
                        </GeometryDrawing.Brush>
                    </GeometryDrawing>
                    <GeometryDrawing Geometry="M 0,32 L 32,32 M 32,0 L 32,32">
                        <GeometryDrawing.Pen>
                            <Pen Brush="#0A1528" Thickness="1"/>
                        </GeometryDrawing.Pen>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <!-- Chamfered Button Style -->
        <Style x:Key="CyberActionBtn" TargetType="Button">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#38BDF8" BlurRadius="10" ShadowDepth="0" Opacity="0.5"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource GridPatternBrush}">
        <Grid.RowDefinitions>
            <!-- MISSION CONTROL TOP DECK -->
            <RowDefinition Height="Auto"/>
            <!-- STATS BAR & INTEGRITY MONITOR -->
            <RowDefinition Height="Auto"/>
            <!-- MAIN BENTO OPS DISPLAY + SYSTEM LOG -->
            <RowDefinition Height="*"/>
            <!-- SCADA TICKER STRIP -->
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- ================= ROW 0: TOP CONTROL DECK ================= -->
        <Border Grid.Row="0" Background="#081020" BorderBrush="#162238" BorderThickness="0,0,0,1" Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="42" Height="42" CornerRadius="8" Background="#060C1B" 
                            BorderBrush="#38BDF8" BorderThickness="1.5" Effect="{StaticResource SubtleHUDGlow}">
                        <Image Source="pic2.jpg" Margin="3" Stretch="UniformToFill"/>
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="TitleText" Text="OCEANREMOTE MONITOR" Foreground="#38BDF8"
                                       FontSize="16" FontWeight="Bold" FontFamily="Consolas"/>
                            <Border Background="#162238" CornerRadius="3" Margin="8,0,0,0" Padding="5,1">
                                <TextBlock Text="SCADA_OPS" Foreground="#64748B" FontSize="9" FontWeight="Bold" FontFamily="Consolas"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#10B981" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="StatusLine" Text="REALTIME REFRIGERATION BUS ACTIVE" 
                                       Foreground="#10B981" FontSize="10" FontWeight="SemiBold" FontFamily="Consolas"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Center Telemetry Matrix Indicator -->
                <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" 
                        Background="#050C1A" BorderBrush="#162238" BorderThickness="1" CornerRadius="20" Padding="14,4">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="REFRIGERATION SUITE:" Foreground="#64748B" FontSize="10" FontFamily="Consolas" VerticalAlignment="Center"/>
                        <TextBlock Text="ZONES A1 - A4" Foreground="#94A3B8" FontSize="10" FontWeight="Bold" FontFamily="Consolas" Margin="6,0,14,0" VerticalAlignment="Center"/>
                        <TextBlock Text="CYCLE RATE:" Foreground="#64748B" FontSize="10" FontFamily="Consolas" VerticalAlignment="Center"/>
                        <TextBlock Text="3000ms" Foreground="#FBBF24" FontSize="10" FontWeight="Bold" FontFamily="Consolas" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Action Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#0B132B" BorderBrush="#162238" BorderThickness="1" CornerRadius="4" Padding="10,4" Margin="0,0,14,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="UTC " Foreground="#64748B" FontSize="11" FontFamily="Consolas" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ClockLabel" Text="00:00:00" Foreground="#38BDF8" FontSize="13" FontWeight="Bold" FontFamily="Consolas" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="UserLabel" Text="OPERATOR: ROOT" Foreground="#94A3B8" FontSize="11" FontFamily="Consolas" VerticalAlignment="Center" Margin="0,0,14,0"/>

                    <Button x:Name="BtnAlerts" Content="ALERTS" Click="Alerts_Click" Style="{StaticResource CyberActionBtn}"
                            Background="#1E1B4B" Foreground="#A78BFA" BorderBrush="#818CF8" BorderThickness="1" Padding="12,6" Margin="0,0,6,0"/>
                    <Button x:Name="BtnRefresh" Content="POLL" Click="Refresh_Click" Style="{StaticResource CyberActionBtn}"
                            Background="#07273C" Foreground="#38BDF8" BorderBrush="#0284C7" BorderThickness="1" Padding="12,6" Margin="0,0,6,0"/>
                    <Button x:Name="BtnLogout" Content="LOGOUT" Click="Logout_Click" Style="{StaticResource CyberActionBtn}"
                            Background="Transparent" Foreground="#F87171" BorderBrush="#EF4444" BorderThickness="1" Padding="12,6"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= ROW 1: STATS & HEALTH DECK ================= -->
        <Border Grid.Row="1" Margin="20,12,20,4" Background="#081020" CornerRadius="10" BorderBrush="#162238" BorderThickness="1" Padding="18,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="1.5*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                    <TextBlock x:Name="LblTotal" Text="ASSIGNED NODES" FontSize="9" Foreground="#64748B" FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TotalLabel" Text="4" FontSize="20" FontWeight="Bold" Foreground="#38BDF8" FontFamily="Consolas" HorizontalAlignment="Center"/>
                </StackPanel>
                <Rectangle Grid.Column="1" Width="1" Fill="#162238" Margin="0,4"/>

                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                    <TextBlock x:Name="LblOnline" Text="ONLINE LINK" FontSize="9" Foreground="#64748B" FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="OnlineLabel" Text="0" FontSize="20" FontWeight="Bold" Foreground="#10B981" FontFamily="Consolas" HorizontalAlignment="Center"/>
                </StackPanel>
                <Rectangle Grid.Column="3" Width="1" Fill="#162238" Margin="0,4"/>

                <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                    <TextBlock x:Name="LblOffline" Text="OFFLINE ISOLATED" FontSize="9" Foreground="#64748B" FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="OfflineLabel" Text="0" FontSize="20" FontWeight="Bold" Foreground="#EF4444" FontFamily="Consolas" HorizontalAlignment="Center"/>
                </StackPanel>
                <Rectangle Grid.Column="5" Width="1" Fill="#162238" Margin="0,4"/>

                <StackPanel Grid.Column="6" HorizontalAlignment="Center">
                    <TextBlock x:Name="LblLastUpdate" Text="TELEMETRY CYCLE" FontSize="9" Foreground="#64748B" FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="LastUpdateLabel" Text="--:--:--" FontSize="16" FontWeight="Bold" Foreground="#FBBF24" FontFamily="Consolas" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                </StackPanel>
                <Rectangle Grid.Column="7" Width="1" Fill="#162238" Margin="0,4"/>

                <StackPanel Grid.Column="8" Margin="14,0,0,0" VerticalAlignment="Center">
                    <Grid Margin="0,0,0,4">
                        <TextBlock Text="COLD CHAIN INTEGRITY INDEX" FontSize="9" Foreground="#64748B" FontWeight="Bold" FontFamily="Consolas"/>
                        <TextBlock x:Name="HealthPercentLabel" Text="100%" FontSize="9" Foreground="#10B981" FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Right"/>
                    </Grid>
                    <ProgressBar x:Name="SystemHealthBar" Height="7" Value="100" Maximum="100" Foreground="#10B981" Background="#162238" BorderThickness="0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= ROW 2: BENTO GRID + SYSTEM EVENT LOG ================= -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="290"/>
            </Grid.ColumnDefinitions>

            <!-- Cold Room Matrix Grid -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12,6">
                <ItemsControl x:Name="DevicesList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="8" Background="#060C1B" CornerRadius="12" 
                                    BorderBrush="{Binding CardBorderBrush}" BorderThickness="1.5" 
                                    Effect="{StaticResource SubtleHUDGlow}" Padding="14,12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Room Header Banner -->
                                    <Grid Grid.Row="0" Margin="0,0,0,6">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="8" Height="8" Fill="{Binding StatusIndicatorBrush}" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Bold" 
                                                       FontFamily="Consolas" Foreground="#F8FAFC"/>
                                            <TextBlock Text="{Binding TargetRangeText}" FontSize="10" Foreground="#64748B" 
                                                       FontFamily="Consolas" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Border HorizontalAlignment="Right" Background="#0B132B" BorderBrush="#162238" BorderThickness="1" CornerRadius="4" Padding="8,2">
                                            <TextBlock Text="{Binding IdBadge}" FontSize="9" FontWeight="Bold" Foreground="#38BDF8" FontFamily="Consolas"/>
                                        </Border>
                                    </Grid>

                                    <!-- Main Panel: Circular Gauge + Matrix 3-Hour Telemetry Module -->
                                    <Grid Grid.Row="1" Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="190"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Circular Gauge in WebView2 -->
                                        <Border Grid.Column="0" Width="185" Height="185" Background="#030712" CornerRadius="92" BorderBrush="#162238" BorderThickness="1">
                                            <wv2:WebView2 x:Name="GaugeView" Width="185" Height="185"
                                                          DefaultBackgroundColor="#030712"
                                                          Loaded="GaugeView_Loaded"/>
                                        </Border>

                                        <!-- Ultra Dark-Blue Matrix 3H Telemetry Box -->
                                        <Border Grid.Column="1" Background="#030712" CornerRadius="8" 
                                                BorderBrush="#0C1D38" BorderThickness="1.5" Margin="8,0,0,0" Padding="10"
                                                Effect="{StaticResource MatrixGlow}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!-- 0: Matrix Header -->
                                                <Grid Grid.Row="0" Margin="0,0,0,4">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Background="#0C1D38" CornerRadius="2" Padding="4,1" Margin="0,0,6,0">
                                                            <TextBlock Text="MATRIX 3H" Foreground="#38BDF8" FontSize="8" FontWeight="Bold" FontFamily="Consolas"/>
                                                        </Border>
                                                        <TextBlock Text="CH_01 // 0.33Hz" Foreground="#0284C7" FontSize="8" FontFamily="Consolas" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <Border HorizontalAlignment="Right" Background="{Binding StateBadgeBg}" CornerRadius="3" Padding="6,1">
                                                        <TextBlock Text="{Binding StateBadgeText}" Foreground="{Binding StateBadgeFg}" FontSize="8" FontWeight="Bold" FontFamily="Consolas"/>
                                                    </Border>
                                                </Grid>

                                                <!-- 1: Live Status & 3H Drift Rate -->
                                                <Border Grid.Row="1" Background="#02040A" CornerRadius="4" BorderBrush="#081426" BorderThickness="1" Padding="6,2" Margin="0,0,0,4">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="SEEN: " FontSize="8" Foreground="#475569" FontFamily="Consolas"/>
                                                            <TextBlock Text="{Binding FormattedLastSeen}" FontSize="8" Foreground="#38BDF8" FontFamily="Consolas" FontWeight="Bold"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="Δ 3H: " FontSize="8" Foreground="#475569" FontFamily="Consolas"/>
                                                            <TextBlock Text="{Binding DriftText}" FontSize="8" Foreground="{Binding DriftColorBrush}" FontWeight="Bold" FontFamily="Consolas"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>

                                                <!-- 2: 3-Hour Trend Sparkline -->
                                                <Border Grid.Row="2" Background="#02040A" CornerRadius="4" BorderBrush="#081426" BorderThickness="1" Margin="0,1,0,3">
                                                    <lvc:CartesianChart Margin="2"
                                                                        Series="{Binding SparklineSeries}"
                                                                        XAxes="{Binding HiddenAxes}"
                                                                        YAxes="{Binding HiddenAxes}"
                                                                        TooltipPosition="Hidden"/>
                                                </Border>

                                                <!-- 3: 3H Aggregates (Min, Mean, Max) -->
                                                <Border Grid.Row="3" Background="#02040A" CornerRadius="4" BorderBrush="#0C1D38" BorderThickness="1" Padding="6,3">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="3H MIN" FontSize="8" Foreground="#475569" FontFamily="Consolas"/>
                                                            <TextBlock Text="{Binding MinTempText}" FontSize="10" Foreground="#38BDF8" FontWeight="Bold" FontFamily="Consolas"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                                            <TextBlock Text="3H MEAN" FontSize="8" Foreground="#475569" FontFamily="Consolas"/>
                                                            <TextBlock Text="{Binding MeanTempText}" FontSize="10" Foreground="#A78BFA" FontWeight="Bold" FontFamily="Consolas"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                                            <TextBlock Text="3H MAX" FontSize="8" Foreground="#475569" FontFamily="Consolas"/>
                                                            <TextBlock Text="{Binding MaxTempText}" FontSize="10" Foreground="#F87171" FontWeight="Bold" FontFamily="Consolas"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </Grid>

                                    <!-- Navigation Action Buttons -->
                                    <Border Grid.Row="2" Background="#040814" CornerRadius="6" BorderBrush="#162238" BorderThickness="1" Margin="0,6,0,0" Padding="5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Button Grid.Column="0" Content="24H LOG" Click="Card_Click" Style="{StaticResource CyberActionBtn}"
                                                    Background="#082F49" Foreground="#38BDF8" BorderBrush="#0284C7" BorderThickness="1" Padding="0,6"/>
                                            <Button Grid.Column="2" Content="30D TREND" Click="Month_Click" Style="{StaticResource CyberActionBtn}"
                                                    Background="#312E81" Foreground="#C7D2FE" BorderBrush="#6366F1" BorderThickness="1" Padding="0,6"/>
                                            <Button Grid.Column="4" Content="PDF REPORT" Click="Report_Click" Style="{StaticResource CyberActionBtn}"
                                                    Background="#2E1065" Foreground="#E9D5FF" BorderBrush="#A855F7" BorderThickness="1" Padding="0,6"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- System Event Log Column -->
            <Border Grid.Column="1" Background="#060C1B" BorderBrush="#162238" BorderThickness="1,0,0,0"
                    Padding="14,12" Margin="0,6,0,6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Ellipse Width="7" Height="7" Fill="#38BDF8" VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock Text="SYSTEM EVENT STREAM" FontSize="11" FontWeight="Bold"
                                   Foreground="#38BDF8" FontFamily="Consolas" VerticalAlignment="Center"/>
                    </StackPanel>

                    <ListBox x:Name="SystemLogList" Grid.Row="1"
                             Background="Transparent" BorderThickness="0"
                             Foreground="#94A3B8" FontFamily="Consolas" FontSize="10"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <TextBlock Text="▪" Foreground="{Binding Color}" Margin="0,0,6,0" VerticalAlignment="Top"/>
                                    <TextBlock Text="{Binding Time}" Foreground="#475569" Margin="0,0,6,0" Width="45"/>
                                    <TextBlock Text="{Binding Message}" Foreground="{Binding Color}" TextWrapping="Wrap" MaxWidth="190"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= ROW 3: SCADA TICKER STRIP ================= -->
        <Border Grid.Row="3" Background="#030712" BorderBrush="#162238" BorderThickness="0,1,0,0" Padding="16,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="SCADA TICKER:" Foreground="#FBBF24" FontSize="9" FontWeight="Bold" FontFamily="Consolas"/>
                <TextBlock x:Name="TickerText" Grid.Column="1" Margin="12,0" Foreground="#64748B" FontSize="9" FontFamily="Consolas" TextTrimming="CharacterEllipsis"
                           Text="SYSTEM HEALTH STEADY // ENCRYPTED LINK SECURE // WAITING NEXT TRANSMISSION..."/>
                <TextBlock Grid.Column="2" Text="TLS 1.3 // NODE BUS READY" Foreground="#38BDF8" FontSize="9" FontFamily="Consolas"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>